# =============================================================================
# Atdevala Stock Watchlist — Environment Variables
# Copy this file to .env and fill in your values.
# NEVER commit the real .env to version control.
# =============================================================================

# ---------------------------------------------------------------------------
# REQUIRED — API server will refuse to start without this
# ---------------------------------------------------------------------------

# Finnhub API key — get a free key at https://finnhub.io
FINNHUB_API_KEY=your_finnhub_api_key_here

# ---------------------------------------------------------------------------
# OPTIONAL — enables the AI write-ups on the Breakout Candidates and Options
# Setups boxes. Without this, those boxes still show their ranked lists and
# real computed drivers, just with "AI analysis unavailable" instead of a
# generated write-up. Get a key at https://console.anthropic.com
# ---------------------------------------------------------------------------
ANTHROPIC_API_KEY=

# ---------------------------------------------------------------------------
# API SERVER (artifacts/api-server)
# ---------------------------------------------------------------------------

# Port the Express API server listens on
PORT=8080

# Node environment — use "production" for production builds
NODE_ENV=development

# Absolute path where signal-history.json is stored.
# Defaults to <api-server-dir>/data/ if not set.
# Set an absolute path for production deployments to ensure stability.
# Example: DATA_DIR=/var/data/atdevala
DATA_DIR=

# ---------------------------------------------------------------------------
# FRONTEND (artifacts/live-dashboard)
# ---------------------------------------------------------------------------

# Port the Vite dev server listens on
# PORT=3000   (use a different value if running both services locally)

# Base path the frontend is served from.
# Use "/" for most standalone deployments (nginx, Docker, VPS, etc.)
# Replit sets this automatically — do not set it manually on Replit.
BASE_PATH=/

# ---------------------------------------------------------------------------
# OPTIONAL — API server
# ---------------------------------------------------------------------------

# Log level for the API server (pino). Default: "info"
# Options: "fatal" | "error" | "warn" | "info" | "debug" | "trace"
# LOG_LEVEL=info

# ---------------------------------------------------------------------------
# OPTIONAL / UNUSED (provisioned but not currently required)
# ---------------------------------------------------------------------------

# SESSION_SECRET=   (reserved for future session-based auth)
# GOOGLE_SERVICE_ACCOUNT_JSON=   (reserved for Google Sheets integration)
